# ===================================
# TRANSPIFY API CONFIGURATION
# ===================================
# IMPORTANT: These variables are BACKEND-ONLY and never exposed to the client
# No VITE_ prefix = Server-side only = Secure

# ===================================
# BACKGROUND REMOVAL APIs
# ===================================

# -------- FREE TIER --------
# Good for testing, development, or low-volume use

# Hugging Face Inference API (FREE - Recommended for free tier)
# Get from: https://huggingface.co/settings/tokens
# Free tier: Unlimited requests (rate limited)
# Quality: Good | Speed: Moderate | Suitable for: Development/Testing
HUGGINGFACE_API_KEY=

# -------- PREMIUM TIER --------
# Best for production, high quality, and commercial use

# Remove.bg API Key (PREMIUM - Recommended for production)
# Get from: https://remove.bg/api
# Pricing: 50 free/month, then $0.20/image or subscription plans
# Quality: Excellent | Speed: Fast | Suitable for: Production
REMOVE_BG_API_KEY=

# ClipDrop API Key (PREMIUM - Highest quality)
# Get from: https://clipdrop.co/apis
# Pricing: Pay as you go, starting from $0.03/image
# Quality: Best | Speed: Fast | Suitable for: Professional/Commercial
CLIPDROP_API_KEY=

# -------- EXPERIMENTAL --------
# For testing only - NOT for background removal

# Google Gemini API Key (EXPERIMENTAL - Image analysis only)
# Get from: https://makersuite.google.com/app/apikey
# Note: Gemini doesn't natively support background removal
# Use case: Image analysis and description
GEMINI_API_KEY=

# OpenAI API Key (EXPERIMENTAL - Image analysis only)
# Get from: https://platform.openai.com/api-keys
# Note: GPT-4 Vision doesn't natively support background removal  
# Use case: Image analysis and description
OPENAI_API_KEY=

# ===================================
# DEPLOYMENT INSTRUCTIONS
# ===================================

# LOCAL DEVELOPMENT:
# 1. Create .env file in project root
# 2. Copy this template
# 3. Add your API keys (without quotes)
# 4. Restart dev server: npm run dev

# VERCEL PRODUCTION:
# 1. Go to Vercel Dashboard → Your Project
# 2. Settings → Environment Variables
# 3. Add each key-value pair:
#    - Name: HUGGINGFACE_API_KEY (or other provider)
#    - Value: your_actual_api_key
#    - Environment: Production (or all)
# 4. Repeat for other providers you want to enable
# 5. Redeploy application
# 6. NEVER commit actual API keys to Git!

# ===================================
# API TIER COMPARISON
# ===================================
# FREE TIER (Hugging Face):
# ✅ Unlimited requests (rate limited)
# ✅ No credit card required
# ✅ Good quality for most use cases
# ⚠️  May be slower during peak times
# ⚠️  Rate limits apply

# PREMIUM TIER (Remove.bg, ClipDrop):
# ✅ Highest quality results
# ✅ Fast processing
# ✅ Production-ready
# ✅ Commercial use allowed
# ⚠️  Requires payment/subscription
# ⚠️  Limited free credits

# ===================================
# SECURITY NOTES
# ===================================
# ✅ API keys stored on server only
# ✅ Never exposed to client/browser
# ✅ Rate limiting enabled (10 req/min per IP)
# ✅ No VITE_ prefix = Not bundled in client code
# ✅ .env file in .gitignore
# ❌ NEVER share API keys in code/screenshots
# ❌ NEVER use localStorage for API keys
# ❌ NEVER commit .env to version control
