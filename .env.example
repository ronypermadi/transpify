# ===================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===================================
# IMPORTANT: These variables are BACKEND-ONLY and never exposed to the client
# No VITE_ prefix = Server-side only = Secure

# Remove.bg API Key (Recommended for production)
# Get from: https://remove.bg/api
# Free tier: 50 requests/month
REMOVE_BG_API_KEY=

# ClipDrop API Key (Optional - Premium quality)
# Get from: https://clipdrop.co/apis
# High quality background removal from Stability AI
CLIPDROP_API_KEY=

# Google Gemini API Key (Optional - Experimental only)
# Get from: https://makersuite.google.com/app/apikey
# Note: Gemini doesn't natively support background removal
GEMINI_API_KEY=

# OpenAI API Key (Optional - Experimental only)
# Get from: https://platform.openai.com/api-keys
# Note: GPT-4 Vision doesn't natively support background removal  
OPENAI_API_KEY=

# ===================================
# DEPLOYMENT INSTRUCTIONS
# ===================================

# LOCAL DEVELOPMENT:
# 1. Create .env file in project root
# 2. Copy this template
# 3. Add your API keys (without quotes)
# 4. Restart dev server: npm run dev

# VERCEL PRODUCTION:
# 1. Go to Vercel Dashboard → Your Project
# 2. Settings → Environment Variables
# 3. Add each key-value pair:
#    - Name: REMOVE_BG_API_KEY
#    - Value: your_actual_api_key
#    - Environment: Production (or all)
# 4. Repeat for other providers you want to enable
# 5. Redeploy application
# 6. NEVER commit actual API keys to Git!

# ===================================
# SECURITY NOTES
# ===================================
# ✅ API keys stored on server only
# ✅ Never exposed to client/browser
# ✅ Rate limiting enabled (10 req/min per IP)
# ✅ No VITE_ prefix = Not bundled in client code
# ✅ .env file in .gitignore
# ❌ NEVER share API keys in code/screenshots
# ❌ NEVER use localStorage for API keys
# ❌ NEVER commit .env to version control
